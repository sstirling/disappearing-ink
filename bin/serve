#!/usr/bin/env bash
#
# Starts the local preview at http://localhost:4000 and rebuilds on save.
# Stop it with Ctrl-C.
#
# This exists so you never have to think about which Ruby is on your PATH.
# macOS ships Ruby 2.6, which is too old for Jekyll, and the Homebrew default
# is Ruby 4, which is too new for the version GitHub Pages builds with. This
# script points at the Ruby 3.3 in between.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

RUBY_PREFIX="$(brew --prefix ruby@3.3 2>/dev/null || true)"
if [[ -z "$RUBY_PREFIX" || ! -x "$RUBY_PREFIX/bin/ruby" ]]; then
  echo "error: Ruby 3.3 not found. Install it with:  brew install ruby@3.3" >&2
  exit 1
fi
export PATH="$RUBY_PREFIX/bin:$PATH"

if [[ ! -d vendor/bundle ]]; then
  echo "Installing gems (first run only)..."
  bundle config set --local path vendor/bundle >/dev/null
  bundle install
fi

# --drafts renders anything in _drafts/ so you can preview an unfinished entry
# without dating it or committing it.
exec bundle exec jekyll serve --livereload --drafts "$@"
